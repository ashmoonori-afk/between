{
  "name": "between-dev",
  "version": "0.2.0",
  "description": "A local terminal broker for AI pair development — observe a developer (Claude) and reviewer (Codex) terminal and coordinate a diff-driven review loop.",
  "keywords": [
    "ai",
    "pair-programming",
    "code-review",
    "agents",
    "cli",
    "broker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashmoonori-afk/between.git"
  },
  "homepage": "https://github.com/ashmoonori-afk/between#readme",
  "bugs": {
    "url": "https://github.com/ashmoonori-afk/between/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./human": {
      "types": "./dist/human.d.ts",
      "import": "./dist/human.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "between": "dist/cli.js",
    "between-dev": "dist/cli.js",
    "between-mcp": "dist/mcp.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "dev": "tsx src/cli.ts",
    "between": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --reporter=verbose",
    "test:vscode": "npm --prefix extensions/vscode-between run check",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --no-file-parallelism --reporter=verbose",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\""
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "ink": "^7.1.0",
    "pino": "^10.3.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.7",
    "write-file-atomic": "^7.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/node": "^25.9.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.9",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "3.0.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12"
  }
}
